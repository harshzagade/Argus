# LEGACY NAME — kept for compatibility with older scripts.
# Identical to Dockerfile.argus; prefer Dockerfile.argus.

FROM python:3.12-slim
WORKDIR /app

# Install dependencies for all three components
COPY server/requirements.txt ./server-req.txt
COPY honeypot/requirements.txt ./honeypot-req.txt
RUN pip install --no-cache-dir -r server-req.txt -r honeypot-req.txt

# Copy all Argus components
COPY server/     ./server/
COPY threatintel/ ./threatintel/
COPY honeypot/   ./honeypot/
COPY rules/      ./rules/
COPY playbooks/  ./playbooks/
COPY dashboard/  ./dashboard/
COPY simulator/  ./simulator/

# Ensure Python can import all packages
RUN touch threatintel/__init__.py || true
RUN touch honeypot/__init__.py    || true

ENV ARGUS_DB=/data/argus.db \
    ARGUS_TI_DB=/data/argus-ti.db \
    ARGUS_API_KEY=argus-dev-key \
    ARGUS_API_KEY=argus-dev-key \
    ARGUS_TI_FEED_INTERVAL=3600

VOLUME /data
EXPOSE 8000

CMD ["uvicorn", "server.argus_app:app", "--host", "0.0.0.0", "--port", "8000"]
